name: cherry_viewer_flutter
description: A Flutter viewer for Cherry Studio chat history
version: 1.0.0+1

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # UI 相关
  cupertino_icons: ^1.0.2
  flutter_markdown: ^0.6.18      # Markdown 渲染
  markdown: ^7.1.1                # Markdown 解析
  flutter_math_fork: ^0.7.1       # LaTeX 数学公式���染
  sticky_headers: ^0.3.0          # 粘性标题

  # 数据处理
  archive: ^3.4.9                 # ZIP 文件解压(对应 Python zipfile)
  path: ^1.8.3                    # 路径处理
  uuid: ^4.2.1                    # UUID 生成

  # 文件操作
  file_picker: ^6.1.1             # 文件选择器
  path_provider: ^2.1.1           # 获取应用目录

  # 网络请求
  http: ^1.1.0                    # HTTP 客户端
  dio: ^5.4.0                     # 更强大的 HTTP 客户端(支持流式响应)

  # 状态管理
  provider: ^6.1.1                # 状态管理(简单易用)

  # 国际化
  intl: ^0.18.1                   # 日期格式化等

  # JSON 处理
  json_annotation: ^4.8.1         # JSON 序列化注解

  # 缓存
  shared_preferences: ^2.2.2      # 持久化存储

  # 日志
  logger: ^2.0.2                  # 日志工具

  # 环境变量
  flutter_dotenv: ^5.1.0          # .env 文件支持

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
  build_runner: ^2.4.6            # 代码生成
  json_serializable: ^6.7.1       # JSON 序列化代码生成

flutter:
  uses-material-design: true

  # 环境变量文件
  assets:
    - .env

  # 字体配置（暂时注释，需要时再添加）
  # fonts:
  #   - family: JetBrainsMono
  #     fonts:
  #       - asset: assets/fonts/JetBrainsMono-Regular.ttf
  #       - asset: assets/fonts/JetBrainsMono-Bold.ttf
  #         weight: 700
